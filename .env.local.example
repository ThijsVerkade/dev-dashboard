# ── dev-dashboard configuration ───────────────────────────────────────────────
# Copy this file to .env.local (which is gitignored) and fill in the blanks.
#
# THIS file is committed to git, so it must NEVER contain real tokens.
# You don't need to paste tokens here at all: on first `npm run dev` the setup
# gate lets you enter your GitLab and Jira tokens in the browser (with
# "Create a token" links), validates them, and writes them to .env.local for you.
# Only the non-secret values below need to be set by hand.

# ── GitLab (Pipelines + repo cloning) ─────────────────────────────────────────
GITLAB_HOST=https://gitlab.bastrucks.com
# Personal access token — scope: read_api (Pipelines) + read_repository (clone repos),
# or `api` for the Release Flow write actions (merge / deploy / tag).
# Leave blank to paste it in the setup gate, or create one and set it here:
#   https://gitlab.bastrucks.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=
# Show ALL projects under these groups (subgroups included):
GITLAB_GROUPS=basworld/auction,basworld/lease
# ...except any project/subgroup under these paths:
GITLAB_EXCLUDE=basworld/auction/0_DEPRICATED
# Optional: extra explicit projects to include (comma-separated paths/ids)
GITLAB_PROJECTS=

# ── Jira (Atlassian Cloud — Issues / Release Flow board) ──────────────────────
JIRA_HOST=https://bas-tech.atlassian.net
# Your own Atlassian account email:
JIRA_EMAIL=you@basworld.com
# API token — leave blank to enter it in the setup gate, or create one and set it here:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=
# Optional: scope sprint/recent views to these project keys (comma-separated, e.g. AUC,LEASE)
JIRA_PROJECTS=

# ── AWS (Logs panel) ──────────────────────────────────────────────────────────
# An SSO profile from ~/.aws/config. BAS profiles: platform-{dev,stg,prod},
# basworld-{dev,stg,prod}, data-{dev,prod,prod-full}, sandbox-dev.
# They share the `bas` SSO session, so one `aws sso login` authorizes dev/stg/prod.
# You can also just click "Log in to AWS SSO" in the app's login gate.
AWS_REGION=eu-central-1
AWS_PROFILE=platform-dev
# Logs panel env switcher: env name -> AWS profile.
CW_REGION=eu-central-1
CW_ENV_PROFILES="dev=platform-dev,stg=platform-stg,prod=platform-prod"

# ── Agent dispatch / repo cloning ─────────────────────────────────────────────
# A group (auction, lease) is the dispatch unit. AGENT_REPOS maps "<group>/<app>"
# to "<repo path under GITLAB_HOST>@<base branch>"; repos clone into ./repos
# (or WORKSPACE_DIR). Set WORKSPACE_DIR=~/workspace to reuse existing clones.
AGENT_GROUPS="auction,lease"
AGENT_REPOS="auction/api:basworld/auction/api@main,auction/app-fe:basworld/auction/app-fe@main,auction/bff-erp:basworld/auction/bff-erp@main,auction/fe-erp:basworld/auction/fe-erp@main,auction/inventory-capture-ext:basworld/auction/inventory-capture-ext@main,auction/web-bff:basworld/auction/web-bff@main,auction/fe:basworld/auction/fe@main,lease/api:basworld/lease/api@main,lease/fe-bff:basworld/lease/fe-bff@main,lease/fe-erp:basworld/lease/fe-erp@main"
# WORKSPACE_DIR=

# --- Knowledge Brain (npm run brain) ---
# Output vault dir (default: brain). Open this folder as an Obsidian vault.
# BRAIN_DIR=brain
# Confluence ADR pages to import — comma-separated page IDs or full page URLs.
# ADR_PAGES=123456,https://<site>.atlassian.net/wiki/spaces/ENG/pages/234567/ADR-6
# Confluence host (defaults to JIRA_HOST if the same Atlassian site).
# CONFLUENCE_HOST=https://<site>.atlassian.net
