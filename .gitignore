# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# agent job records (runtime: metadata + logs)
/.agent-jobs

# cloned application repos (installed by `npm run setup`)
/repos

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local

# local tooling
.superpowers/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# Knowledge Brain generated vault (built by `npm run brain`)
/brain
